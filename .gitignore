/*
!/.git[a-z]*
!/.github/
!/.dotstate-profiles.toml
!/common/
!/macos/
!/linux/
!/install.sh
!/test.sh
!/AGENTS.md
!/README.md

# Shared skills: only tracked skills and the skills CLI lockfile, not the
# skills it installs
/common/.agents/*
!/common/.agents/skills/
!/common/.agents/.skill-lock.json

# Claude Code: only portable settings and themes, never sessions or caches
/common/.claude/*
!/common/.claude/settings.json
!/common/.claude/themes/

# pi: only the settings file, never auth or session state
/common/.pi/*
!/common/.pi/agent/
/common/.pi/agent/*
!/common/.pi/agent/settings.json

# Runtime state written into linked directories
*.log
\.DS_Store
/common/.config/tmux/plugins/
/common/.config/zsh/secrets.zsh
/common/.config/herdr/session-history.json
/common/.config/herdr/session.json
/common/.config/herdr/release-notes.json
/common/.config/herdr/plugins.json
/common/.config/herdr/plugins/*
!/common/.config/herdr/plugins/config/
/common/.config/herdr/.plugins.lock
/common/.config/herdr/herdr.sock.agent
/common/.config/herdr/session-snapshots/
/common/.config/opencode/opencode-notifier-state.json
/common/.config/opencode/skills/impeccable/
/common/.config/worktrunk/config.toml.lock
