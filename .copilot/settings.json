{
  "allowedUrls": [
    "https://dev.azure.com",
    "http://localhost",
    "http://localhost:*",
    "https://localhost",
    "https://localhost:*"
  ],
  "companyAnnouncements": [
    "GPT-5.6 Sol, Terra, and Luna are now available in Copilot CLI. Try them from the model picker.",
    "Need help with Agency? Run `agency support` or join the support community: https://aka.ms/agency/support"
  ],
  "enabledPlugins": {
    "azure@awesome-copilot": true,
    "figma@awesome-copilot": true,
    "microsoft-docs@awesome-copilot": true,
    "rust-mcp-development@awesome-copilot": true,
    "software-engineering-team@awesome-copilot": true
  },
  "extraKnownMarketplaces": {},
  "hooks": {
    "sessionStart": [
      {
        "_vsCodeCompat": "SessionStart",
        "bash": "bash '/Users/rejuv/.copilot/hooks/herdr-agent-state.sh'",
        "timeoutSec": 10,
        "type": "command"
      }
    ]
  },
  "includeCoAuthoredBy": false,
  "logLevel": "all",
  "model": "gpt-5.6-sol",
  "subagents": {
    "agents": {
      "code-review": {
        "contextTier": "default",
        "effortLevel": "medium",
        "model": "gpt-5.6-sol"
      },
      "explore": {
        "contextTier": "default",
        "effortLevel": "medium",
        "model": "gpt-5.6-sol"
      },
      "general-purpose": {
        "contextTier": "default",
        "effortLevel": "medium",
        "model": "gpt-5.6-sol"
      },
      "research": {
        "contextTier": "default",
        "effortLevel": "medium",
        "model": "gpt-5.6-sol"
      },
      "rubber-duck": {
        "autoInvoke": true,
        "contextTier": "default",
        "effortLevel": "medium",
        "model": "claude-opus-4.8"
      },
      "security-review": {
        "contextTier": "default",
        "effortLevel": "medium",
        "model": "gpt-5.6-sol"
      },
      "software-engineering-team:se-system-architecture-reviewer": {
        "contextTier": "default",
        "effortLevel": "medium",
        "model": "gpt-5.6-sol"
      },
      "software-engineering-team:se-ux-ui-designer": {
        "contextTier": "default",
        "effortLevel": "medium",
        "model": "gpt-5.6-sol"
      },
      "task": {
        "contextTier": "default",
        "effortLevel": "medium",
        "model": "gpt-5.6-sol"
      }
    }
  },
  "theme": "default"
}
