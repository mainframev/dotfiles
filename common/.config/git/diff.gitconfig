[diff]
  colorMoved = default
  algorithm = histogram
[difftool]
  prompt = true
[difftool "nvimdiff"]
  cmd = "nvim -d \"$LOCAL\" \"$REMOTE\""
[difftool "kitty"]
  cmd = kitty +kitten diff \"$LOCAL\" \"$REMOTE\"
[difftool "kitty.gui"]
  cmd = kitty kitty +kitten diff \"$LOCAL\" \"$REMOTE\"
[difftool "nvim"]
  cmd = nvim -d \"$LOCAL\" \"$REMOTE\"
